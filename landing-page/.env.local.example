# Base URL of the FastAPI backend (see BACKEND.md). Not yet consumed by any
# component — /api/leads currently only logs submissions. Set this once the
# backend exposes a leads endpoint and you wire up the forward described in
# BACKEND.md.
NEXT_PUBLIC_API_URL=https://api.voxa.ai

# VAPI Web SDK — powers the "Try it live" in-browser voice demo
# (components/LiveDemo.tsx, components/FloatingDemoButton.tsx).
# Get these from your VAPI dashboard (https://dashboard.vapi.ai):
#   - NEXT_PUBLIC_VAPI_PUBLIC_KEY: Dashboard > API Keys > Public Key
#   - NEXT_PUBLIC_VAPI_ASSISTANT_ID: Dashboard > Assistants > (your assistant) > ID
# Both are safe to expose client-side (that's what the public key is for) —
# access control lives on the assistant's config in the VAPI dashboard, not
# here. Until both are set, the live demo widget shows a disabled
# "being configured" state instead of erroring.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
